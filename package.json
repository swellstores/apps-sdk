{
  "name": "@swell/apps-sdk",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Server SDK for Swell apps — local implementation experiment.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "test:boundaries": "node scripts/verify-boundaries.mjs",
    "test:worker": "node scripts/verify-worker.mjs"
  },
  "peerDependencies": {
    "swell-js": ">=5.9.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "miniflare": "5.20260911.1-alpha",
    "swell-js": "5.9.0",
    "typescript": "5.7.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "workerd": "./dist/index.js",
      "node": "./dist/index.js",
      "browser": "./dist/browser-refusal.js",
      "default": "./dist/index.js"
    },
    "./storefront": {
      "types": {
        "import": "./dist/storefront.d.ts",
        "require": "./dist/storefront.d.cts"
      },
      "workerd": "./dist/storefront.js",
      "node": "./dist/storefront.js",
      "browser": "./dist/browser-refusal.js",
      "default": "./dist/storefront.js"
    }
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/storefront.js",
    "./dist/guard.js",
    "./dist/browser-refusal.js"
  ]
}
